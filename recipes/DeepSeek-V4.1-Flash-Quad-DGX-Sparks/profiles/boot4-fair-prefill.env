# boot4 - boot2 plus two config-only changes:
#   --long-prefill-token-threshold  caps each scheduler step's slice of a long
#     prefill so co-scheduled decodes keep stepping. 2048 measured: a stream
#     started during a cold 210K prefill gets a chunk every 1.03 s instead of
#     one per ~5 s step; costs 9-13% cold-prefill throughput above the cap,
#     nothing below it. 4096 halves both effects; 8192 is a no-op.
#   --limit-mm-per-prompt {"image":16}  multi-turn clients resend every history
#     image, so a text-only turn after four images used to fail with
#     "At most 4 image(s)". The profile run is bounded by max-num-batched-tokens,
#     so the KV cost does not scale with this number.
export EXP_NAME=boot4 PATCH_NAME=dsv41-boot10 ENGRAM_LOCAL=1
export GMU=0.80 MAXLEN=300000 SEQS=8 EAGER=0 CUDAGRAPH_MODE=FULL_AND_PIECEWISE
export SPEC=dspark SPEC_K=5
export ENGRAM_DISK=1 TEXT_ONLY=0 THINKING=false PARSERS=1 RUST_FE=0
export CTRL=fabric NCCL_DEBUG=WARN
export NCCL_EXTRA="-e MAX_JOBS=2 -e FLASHINFER_NVCC_THREADS=1 -e VLLM_USE_FLASHINFER_SAMPLER=0 -e TILELANG_CACHE_DIR=/cache/tilelang -e TRITON_CACHE_DIR=/cache/triton"
export VLLM_EXTRA='--block-size 128 --limit-mm-per-prompt {"image":16} --mm-processor-cache-gb 1 --long-prefill-token-threshold 4096'
