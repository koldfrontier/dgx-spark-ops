# boot1 - first boot on new hardware. Eager (no CUDA graphs), text only, 131K.
# Proves the ring, the checkpoint, the patch set and RDMA before any of the
# things that can fail silently (graphs, speculation, vision) are switched on.
# Expect ~15 tok/s single stream: this profile is a gate, not a serving config.
export EXP_NAME=boot1 PATCH_NAME=dsv41-boot10 ENGRAM_LOCAL=1
export GMU=0.80 MAXLEN=131072 SEQS=8 EAGER=1 SPEC=none
export ENGRAM_DISK=1 TEXT_ONLY=1 THINKING=false PARSERS=0 RUST_FE=0
export CTRL=private NCCL_DEBUG=WARN
export NCCL_EXTRA="-e VLLM_USE_FLASHINFER_SAMPLER=0 -e TILELANG_CACHE_DIR=/cache/tilelang -e TRITON_CACHE_DIR=/cache/triton"
export VLLM_EXTRA='--block-size 128'
