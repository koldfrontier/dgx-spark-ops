# boot5 - boot4 plus the 1M-context window, following ZackO2o's recipe
# (https://github.com/ZackO2o/DeepSeek-V4.1-Flash-4x-GB10-1M-Full-Recipe, MIT).
#   PATCH_NAME  a patch directory that ALSO contains their gpu_worker.py and a
#               mounts.txt line "gpu_worker.py v1/worker/gpu_worker.py".
#               Verify that file against your own tree before mounting it:
#               it must be your image's gpu_worker.py plus their four hunks
#               and nothing else (see the README, "Verifying a whole-file patch").
#   GMU 0.83    their working range is 0.83-0.84; 600K did not boot at 0.80 on
#               their fleet. Ours: KV pool 1,992,707 tokens = 1.90x a 1M request.
#   the two DSV41_* gates skip the throwaway graph-memory profiling pass and
#   zero KV/Engram/lookback state once after capture (graph addresses retained).
export EXP_NAME=boot5 PATCH_NAME=dsv41-boot10-1m ENGRAM_LOCAL=1
export GMU=0.83 MAXLEN=1048576 SEQS=8 EAGER=0 CUDAGRAPH_MODE=FULL_AND_PIECEWISE
export SPEC=dspark SPEC_K=5
export ENGRAM_DISK=1 TEXT_ONLY=0 THINKING=false PARSERS=1 RUST_FE=0
export CTRL=fabric NCCL_DEBUG=WARN
export NCCL_EXTRA="-e MAX_JOBS=2 -e FLASHINFER_NVCC_THREADS=1 -e VLLM_USE_FLASHINFER_SAMPLER=0 -e TILELANG_CACHE_DIR=/cache/tilelang -e TRITON_CACHE_DIR=/cache/triton -e DSV41_SKIP_GRAPH_MEMORY_PROFILE=1 -e DSV41_CLEAR_STATE_AFTER_CAPTURE=1"
export VLLM_EXTRA='--block-size 128 --limit-mm-per-prompt {"image":16} --mm-processor-cache-gb 1 --long-prefill-token-threshold 4096'
