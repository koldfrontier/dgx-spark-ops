# boot6 - boot5 plus two Engram-path levers from tonyd2wild's 2026-09-14 speed run
# (runs/2026-09-14-speedrun in that repo, MIT), and a 500K window instead of 1M.
#   PATCH_NAME  a patch directory that is your 1M set (boot 10's seven +
#               gpu_worker.py) with engram.py REPLACED by the speed run's
#               patches/dsv41-exl3-sr1/engram.py (md5 e84c7305). Verify first:
#               it must be your boot-10 engram.py (md5 c0329107) plus their
#               engram-fast.diff (151 lines, 6 hunks) and nothing else - apply
#               the diff to your file and compare md5s.
#   DSV41_ENGRAM_FAST=1   memmap gather of the de-duplicated rows on the read
#               pool, raw fp8 rows + scales to the GPU, dequant there (their
#               test tool shows bit-identical staged rows).
#   ENGRAM_THREADS=128    the read-pool size (was 32).
#   MAXLEN=524288         500K: the pool goes from 1.9x a 1M request to ~5x a 500K one.
# Measured on four GB10s on the ring vs boot5: cold prefill +16% at 3K, +48% at
# 12K, +27% at 47K, +5% at 93K, unchanged at 130K, -7% at 300K; decode unchanged;
# C6 152 vs 144. Keep if your prompts are mostly under 100K.
export EXP_NAME=boot6 PATCH_NAME=dsv41-boot10-1m-fast ENGRAM_LOCAL=1 ENGRAM_THREADS=128
export GMU=0.83 MAXLEN=524288 SEQS=8 EAGER=0 CUDAGRAPH_MODE=FULL_AND_PIECEWISE
export SPEC=dspark SPEC_K=5
export ENGRAM_DISK=1 TEXT_ONLY=0 THINKING=false PARSERS=1 RUST_FE=0
export CTRL=fabric NCCL_DEBUG=WARN
export NCCL_EXTRA="-e MAX_JOBS=2 -e FLASHINFER_NVCC_THREADS=1 -e VLLM_USE_FLASHINFER_SAMPLER=0 -e TILELANG_CACHE_DIR=/cache/tilelang -e TRITON_CACHE_DIR=/cache/triton -e DSV41_SKIP_GRAPH_MEMORY_PROFILE=1 -e DSV41_CLEAR_STATE_AFTER_CAPTURE=1 -e DSV41_ENGRAM_FAST=1"
export VLLM_EXTRA='--block-size 128 --limit-mm-per-prompt {"image":16} --mm-processor-cache-gb 1 --long-prefill-token-threshold 4096'
