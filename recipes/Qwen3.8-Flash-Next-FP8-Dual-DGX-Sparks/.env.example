# eugr/spark-vllm-docker cluster config - copy to .env in the toolkit's own
# directory and fill in your own values. Never commit a real .env; it
# describes your private network layout.

# Comma-separated fabric IPs, head node first.
CLUSTER_NODES=10.10.10.1,10.10.10.2

# Fabric NIC name - verify with `ip -br link` on YOUR hardware, do not
# assume it matches this example.
ETH_IF=enp1s0f1np1

# RDMA device name - verify with `ibv_devices` on YOUR hardware.
IB_IF=rocep1s0f1

# Port used for cluster-coordination rendezvous, not the API port.
MASTER_PORT=29601

CONTAINER_NAME=vllm_node_qwen38fp8
