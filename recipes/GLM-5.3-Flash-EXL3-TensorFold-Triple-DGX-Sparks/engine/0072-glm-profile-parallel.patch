-                                        feed=lane.feed, mtp=False, head=stop == n)
+                    # TF_GLM_PROFILE=1 under --parallel: arm the prefill profiler around a whole-chunk fill as the
+                    # serial path does (decode.prefill), and report once per prompt, on every rank
+                    from . import prof
+                    prof.active = prof.ENABLED
+                    try:
+                        out = prefill_chunk(e, prompt, start, stop - start, drafter=self._ctx(lane) if lane.dflash else None,
+                                            feed=lane.feed, mtp=False, head=stop == n)
+                    finally:
+                        prof.active = False
+                    if prof.ENABLED:
+                        begin = _PROF_BEGIN.setdefault(id(lane), start)
+                        if stop == n:
+                            prof.report(n - _PROF_BEGIN.pop(id(lane), begin))
